# ===== API =====
API_PORT=3001
# 多个来源用逗号分隔；浏览器用 127.0.0.1 打开前端时 Origin 不同于 localhost，需同时列出
API_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=12h

# DB driver (mysql only)
DB_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=distribution

# Lingxing Open API
LINGXING_BASE_URL=https://openapi.lingxing.com
LINGXING_APP_ID=
LINGXING_APP_SECRET=
# TLS 报错「socket disconnected before TLS」时可保持 true（默认 IPv4 优先）；无需则设为 false
LINGXING_IPV4_FIRST=true
# 直连报 TLS/握手失败时必填：本机 Clash 等，例如 http://127.0.0.1:7890（也可用系统 HTTPS_PROXY）
LINGXING_HTTPS_PROXY=
# 自动尝试常见本地代理端口（7890/7897/10809）后再回退直连
LINGXING_AUTO_PROXY_CANDIDATES=true
LINGXING_PROXY_CANDIDATES=http://127.0.0.1:7890,http://127.0.0.1:7897,http://127.0.0.1:10809
# 网络偶发抖动时重试：重试次数（不含首次），延时基数 ms
LINGXING_TRANSPORT_RETRIES=2
LINGXING_TRANSPORT_RETRY_DELAY_MS=800
# Axios 超时（毫秒）：代理较慢或盘点数据多时可再大
LINGXING_TOKEN_TIMEOUT_MS=90000
LINGXING_HTTP_TIMEOUT_MS=180000
# Inventory sync request (optional)
LINGXING_INVENTORY_PATH=/erp/sc/routing/data/local_inventory/inventoryDetails
LINGXING_INVENTORY_WID=
LINGXING_INVENTORY_SKU=
LINGXING_INVENTORY_PAGE_SIZE=200
LINGXING_WAREHOUSE_NAME_MAP=
# Push orders to Lingxing (optional; if STORE_ID empty will fallback to LINGXING_EBAY_SIDS)
LINGXING_PUSH_PLATFORM_CODE=10009
LINGXING_PUSH_STORE_ID=
LINGXING_PUSH_WID=
LINGXING_PUSH_LOGISTICS_TYPE_ID=
# eBay product sync request (optional)
LINGXING_EBAY_PRODUCT_PATH=/erp/sc/routing/data/ebay/itemList
LINGXING_EBAY_WID=
LINGXING_EBAY_SKU=
LINGXING_EBAY_PAGE_SIZE=100

# eBay Official API (Buy Browse API)
# Create an eBay app in Developer Program, then fill in Client ID/Secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Browse API commonly uses client credentials grant with api_scope
EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope

# Admin-only login: when true, DISTRIBUTOR role cannot sign in
ADMIN_ONLY_LOGIN=false

# With SEED_ADMIN_PHONE set: when true, only the user whose `phone` matches SEED_ADMIN_PHONE can log in (other ADMIN emails are rejected).
ADMIN_LOGIN_PHONE_ONLY=false

# Seed admin (created on first boot if missing)
# Prefer phone login: set SEED_ADMIN_PHONE + SEED_ADMIN_PASSWORD (SEED_ADMIN_EMAIL optional; default is <digits>@user.local)
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
# Leave empty to skip seeding a distributor
SEED_DISTRIBUTOR_EMAIL=dist@example.com
SEED_DISTRIBUTOR_PASSWORD=dist123

# ===== Web =====
VITE_API_BASE_URL=http://localhost:3001/api/v1
